    <Authors>Ray Carioto</Authors>
    <Company>Ray Carioto</Company>
    <Copyright>Copyright (C) 2026 Ray Carioto &lt;raymond.carioto@gmail.com&gt;</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Product>BinSight</Product>
    <Description>Core PE analysis library for BinSight. Author: Ray Carioto &lt;raymond.carioto@gmail.com&gt;.</Description>
    <Version>1.3.0</Version>
  </PropertyGroup>

</Project>
